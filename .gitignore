# macOS
.DS_Store
._*

# Python（backend/）
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
backend/.venv/
venv/

# SQLite 数据库（首次启动自动重建，含演示数据）
*.db
*.sqlite3

# Node / 前端（frontend/）
node_modules/
frontend/dist/
*.local
npm-debug.log*

# 日志
*.log

# 本地环境配置（模板 .env.example 入库，实际值不入库）
.env
backend/.env

# ZCode 本地配置与会话计划（本地产物，不入库）
.zcode/

# 项目长期记忆（含本地部署环境细节，仅本机保留不入库）
AGENTS.md

# 设计资产与验收截图（仅本机保留不入库）
design/
design-system/
screenshots/

# 浏览器验证临时截图（正式验收截图在 screenshots/）
gui-test-screenshots/

# 数据库备份产物（scripts/backup.sh 生成，只在服务器留存，绝不入库）
backups/
*.sql.gz
*.summary.txt
