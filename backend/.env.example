# 云栖 PMS · 后端本地配置模板
#
# 用法：
#   cp backend/.env.example backend/.env   # 再按需改值（backend/.env 已被 gitignore，不入库）
#
# 优先级：shell 里显式 export 的环境变量 > backend/.env > 项目根 .env > 代码内默认值。
# 改完需重启后端（uvicorn 只在启动时读一次）。

# ---- 登录滑块验证码 ----
# off = 本地开发/自动化不用拖滑块（登录按钮直接可用）；on 或不写 = 每次登录都要验证
CAPTCHA=off

# ---- JWT 签名密钥 ----
# 生产必须换成随机值（如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
# JWT_SECRET=change-me-in-production

# ---- 数据库 ----
# 引擎：sqlite（缺省，本地文件，删掉该文件会重建演示数据）| mysql（docker compose 起库）
# DB_ENGINE=sqlite
# DB_PATH=/absolute/path/to/pms.db
#
# MySQL：docker compose up -d 起好库后取消注释；参数无默认值，五项必须全部显式配置
# （缺一启动即报错并列出缺失项；密码含特殊字符无需自己转义，代码会做 URL 编码）：
# DB_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=pms
# DB_PASSWORD=pms123456
# DB_NAME=pms
